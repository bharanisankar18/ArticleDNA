# Copy this file to .env and fill in your key. Never commit .env.

# Required: your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Gemini model ID. gemini-2.5-flash shuts down on 2026-12-01; use a 3.x model.
GEMINI_MODEL=gemini-3.6-flash

# Optional tuning
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2
GEMINI_TEMPERATURE=0.2
MAX_CONTENT_CHARS=100000
MIN_CONTENT_WORDS=50
MAX_CONCURRENT_ANALYSES=4

# Optional: restrict the API to your extension (comma-separated IDs from chrome://extensions).
# Leave empty to accept any chrome-extension:// origin.
ALLOWED_EXTENSION_IDS=

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Fallback AI providers. When Gemini is rate limited or down, these are tried
# in this order. Leave a key empty to skip that provider.
AI_PROVIDERS=gemini,groq,openrouter,ollama

# Groq: free key at https://console.groq.com/keys (open models, very fast)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter: free key at https://openrouter.ai/keys (use a model ID ending in :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Ollama: runs models on your own computer, no key and no limits (slower).
# Install from https://ollama.com, run `ollama pull llama3.1:8b`, then set:
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
